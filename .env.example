# ==============================================================================
# CodeMind Environment Configuration Template
# Copy this file to .env or set environment variables in your runtime environment.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/codemind
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# AI Chat Provider Configuration (OpenAI or compatible: SenseNova, Groq, vLLM)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# Jina Embeddings Configuration (jina-embeddings-v3, 1024 dims)
# Free API key available at https://jina.ai/embeddings/
JINA_API_KEY=your-jina-api-key-here
JINA_EMBEDDING_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIMENSIONS=1024

# Ollama Embeddings Configuration (Local / Offline alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Qdrant Vector Store Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_GRPC_PORT=6334
QDRANT_HTTP_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=codemind-code-chunks
QDRANT_USE_TLS=false

# Jina Reranking Configuration (Optional, free key at https://jina.ai/reranker/)
CODEMIND_RERANK_ENABLED=true
JINA_BASE_URL=https://api.jina.ai/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
CODEMIND_RERANK_CANDIDATE_MULTIPLIER=3

# CodeMind Ingestion & Workspace Configuration
CODEMIND_WORKSPACE_DIR=./workspaces
CODEMIND_CLONE_TIMEOUT_SECONDS=60
CODEMIND_MAX_FILE_SIZE_KB=500
CODEMIND_MAX_FILES_PER_REPO=1500
CODEMIND_EMBEDDING_BATCH_SIZE=32
CODEMIND_DEFAULT_TOP_K=8
