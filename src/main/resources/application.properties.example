# Server Configuration
server.port=8080

# Spring Application
spring.application.name=CodeMind

# PostgreSQL Database Configuration
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/codemind}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:postgres}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:postgres}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Provider selection when multiple starters (OpenAI + Ollama) are on classpath
spring.ai.model.chat=openai
spring.ai.model.embedding=openai

# OpenAI / OpenAI-compatible Chat endpoint configuration (Supports OpenAI, SenseNova, Groq, vLLM)
spring.ai.openai.api-key=${OPENAI_API_KEY:your-api-key-here}
spring.ai.openai.base-url=${OPENAI_BASE_URL:https://api.openai.com}
spring.ai.openai.chat.model=${OPENAI_CHAT_MODEL:gpt-4o-mini}

# Jina Embeddings (OpenAI-compatible) configuration
# Uses Jina AI's state-of-the-art multilingual code & text embedding model
spring.ai.openai.embedding.base-url=${JINA_EMBEDDING_BASE_URL:https://api.jina.ai/v1}
spring.ai.openai.embedding.api-key=${JINA_API_KEY:${OPENAI_API_KEY:your-jina-api-key-here}}
spring.ai.openai.embedding.model=${JINA_EMBEDDING_MODEL:jina-embeddings-v3}
spring.ai.openai.embedding.dimensions=${JINA_EMBEDDING_DIMENSIONS:1024}

# Ollama local embeddings configuration (Alternative / offline option)
spring.ai.ollama.base-url=${OLLAMA_BASE_URL:http://localhost:11434}
spring.ai.ollama.embedding.model=${OLLAMA_EMBEDDING_MODEL:nomic-embed-text}

# Actuator Endpoints
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=when_authorized

# Springdoc OpenAPI / Swagger UI
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.operations-sorter=method

# CodeMind Ingestion & Workspace Configuration
codemind.workspace-dir=${CODEMIND_WORKSPACE_DIR:./workspaces}
codemind.clone-timeout-seconds=${CODEMIND_CLONE_TIMEOUT_SECONDS:60}
codemind.max-file-size-kb=${CODEMIND_MAX_FILE_SIZE_KB:500}
codemind.max-files-per-repo=${CODEMIND_MAX_FILES_PER_REPO:1500}
codemind.embedding-batch-size=${CODEMIND_EMBEDDING_BATCH_SIZE:32}
codemind.default-top-k=${CODEMIND_DEFAULT_TOP_K:8}

# Qdrant Vector Store Configuration
codemind.qdrant.host=${QDRANT_HOST:localhost}
codemind.qdrant.port=${QDRANT_PORT:6334}
codemind.qdrant.grpc-port=${QDRANT_GRPC_PORT:6334}
codemind.qdrant.http-port=${QDRANT_HTTP_PORT:6333}
codemind.qdrant.api-key=${QDRANT_API_KEY:}
codemind.qdrant.collection-name=${QDRANT_COLLECTION:codemind-code-chunks}
codemind.qdrant.use-tls=${QDRANT_USE_TLS:false}

# Jina Reranking Configuration
codemind.rerank.enabled=${CODEMIND_RERANK_ENABLED:true}
codemind.rerank.api-key=${JINA_API_KEY:your-jina-api-key-here}
codemind.rerank.base-url=${JINA_BASE_URL:https://api.jina.ai/v1/rerank}
codemind.rerank.model=${JINA_RERANK_MODEL:jina-reranker-v2-base-multilingual}
codemind.rerank.candidate-multiplier=${CODEMIND_RERANK_CANDIDATE_MULTIPLIER:3}
